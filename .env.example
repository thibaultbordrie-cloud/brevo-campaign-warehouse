# Copy this file to .env. .env is ignored by Git and holds NO key.
# Keys go in the Windows Credential Manager (encrypted with your session):
#   python run.py secret set BREVO_API_KEY
#   python run.py secret check
#
# Behind a corporate proxy that re-signs HTTPS, the Windows certificate store is used
# automatically (truststore). A CA bundle file can be given instead:
# BREVO_CA_BUNDLE=C:\path\to\corporate_ca.pem
# Last resort only: BREVO_VERIFY_SSL=false
#
# Optional: where the database lives (default: data/warehouse.duckdb)
# WAREHOUSE_DB=

# Daily alert email (sent only to you), through the Brevo API over HTTPS.
# ALERT_FROM must be a sender on a domain authenticated in your Brevo account: a sender on
# another domain is accepted by Brevo, then bounced by the receiving server (DMARC).
ALERT_FROM=
ALERT_FROM_NAME=Warehouse alerts
ALERT_TO=
# ALERT_METHOD=smtp    (only if port 587 is open; ALERT_SMTP_LOGIN + password in the vault)
